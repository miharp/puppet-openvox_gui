<%- | Stdlib::Absolutepath $src_dir | -%>
#!/bin/bash
# This file is managed by Puppet.
#
# Builds the OpenVox GUI React frontend. On aarch64 npm can leave out the
# bundler's native binding on the first install
# (https://github.com/npm/cli/issues/4828): rollup's up to OpenVox GUI
# 3.12.0, rolldown's (Vite 8) after. Whichever the checked-out lockfile
# lists is added explicitly, at the lockfile's version and without
# touching package.json, so the checkout stays clean for vcsrepo. Stamps
# frontend/.built-version on success so Puppet re-runs the build only
# when the checked-out VERSION changes.
set -e
cd '<%= $src_dir %>/frontend'
npm install
if [ "$(uname -m)" = "aarch64" ]; then
  for binding in @rolldown/binding-linux-arm64-gnu @rollup/rollup-linux-arm64-gnu; do
    version=$(node -e '
      const lock = require("./package-lock.json");
      const pkg = (lock.packages || {})["node_modules/" + process.argv[1]];
      if (pkg && pkg.version) process.stdout.write(pkg.version);
    ' "$binding")
    if [ -n "$version" ] && [ ! -d "node_modules/$binding" ]; then
      npm install --no-save "$binding@$version"
    fi
  done
fi
npm run build
cp ../VERSION .built-version
